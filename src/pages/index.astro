---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf()).slice(0,2);
const news = [
  {date:'2026.10.15',tag:'お知らせ',title:'SI研究所のWebサイトを公開しました',href:'/news/site-launch/'},
  {date:'2026.10.08',tag:'技術ノート',title:'小さく始める業務改善とシステム導入',href:'/news/business-improvement/'},
  {date:'2026.09.24',tag:'お知らせ',title:'Web制作・システム開発のご相談受付を開始しました',href:'/news/consultation-open/'}
];
---
<BaseLayout title="SI研究所 | Web制作・システム開発・SI導入支援" description="Web制作、システム開発、SI導入支援。事業課題を整理し、設計から実装・運用まで支援します。">
<section class="hero"><div><span class="eyebrow">Software / Web / Integration</span><h1>事業の課題を、<br /><em>実装できる答えに。</em></h1><p class="hero-copy">SI研究所は、Web制作・システム開発・SI導入支援を通じて、事業と技術のあいだにある課題を整理し、現場で使える仕組みへとつなげます。</p><div class="hero-actions"><a class="button" href="/services/">事業内容を見る <span>↗</span></a><a class="text-link" href="/contact/">相談する</a></div></div><div class="hero-image"><img src="https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=1400&q=85" alt="自然光が入るオフィスのワークスペース" /><span class="image-note">SI LAB / WORKING WITH CLARITY</span><span class="hero-index">01 — 03</span></div></section>
<div class="intro-strip"><span>01&nbsp; WEB DEVELOPMENT</span><span>02&nbsp; SYSTEM ENGINEERING</span><span>03&nbsp; SI SUPPORT</span><span>JAPAN / REMOTE FRIENDLY</span></div>
<section class="section"><div class="section-heading"><div><span class="eyebrow">Services / 01—03</span><h2>必要なところから、<br />確実に前へ進める。</h2></div><p class="section-intro">最初から大きな仕組みをつくる必要はありません。現状を理解し、優先順位を整理して、効果が見えるところから一緒に取り組みます。</p></div><div class="service-grid"><article class="service-card"><span class="service-num">SERVICE 01 / WEB</span><h3>Web制作</h3><p>情報設計からデザイン、実装まで。伝えたいことが伝わり、運用しやすいWebサイトを設計します。</p><a href="/services/">サービス詳細 ↗</a></article><article class="service-card"><span class="service-num">SERVICE 02 / DEV</span><h3>システム開発</h3><p>業務フローと現場の要件を整理し、保守性と使いやすさを意識したシステムを開発します。</p><a href="/services/">サービス詳細 ↗</a></article><article class="service-card"><span class="service-num">SERVICE 03 / SI</span><h3>SI導入支援</h3><p>要件定義、ベンダー調整、導入プロジェクトの推進まで、関係者の間に立って支援します。</p><a href="/services/">サービス詳細 ↗</a></article></div></section>
<section class="photo-band"><img src="https://images.unsplash.com/photo-1497366811353-6870744d04b2?auto=format&fit=crop&w=1200&q=80" alt="ミーティングスペースのあるオフィス" loading="lazy" /><div class="photo-band-copy"><span class="eyebrow">How We Work</span><h2>技術選定より先に、<br />課題を正しく理解する。</h2><p>ツールや製品を導入すること自体を目的にせず、何を変えたいのか、どんな運用が現実的かを一緒に整理します。要件と期待値をそろえ、無理のない計画に落とし込みます。</p><a class="text-link" href="/company/">SI研究所について ↗</a></div></section>
<section class="section"><div class="section-heading"><div><span class="eyebrow">News / Updates</span><h2>ニュース</h2></div><a class="text-link" href="/news/">一覧を見る ↗</a></div><div class="news-list">{news.map(n=><a class="news-row" href={n.href}><time>{n.date}</time><span class="news-tag">{n.tag}</span><span>{n.title}</span><span class="arrow">↗</span></a>)}</div></section>
<section class="section"><div class="section-heading"><div><span class="eyebrow">Engineering Notes</span><h2>技術ブログ</h2></div><a class="text-link" href="/blog/">記事一覧 ↗</a></div><div class="blog-list">{posts.map(post=><article class="blog-card"><div class="blog-meta"><time>{post.data.pubDate.toLocaleDateString('ja-JP')}</time><span>{post.data.category}</span></div><h2><a href={`/blog/${post.id.replace(/\.md$/,'')}/`}>{post.data.title}</a></h2><p>{post.data.description}</p><a class="text-link" href={`/blog/${post.id.replace(/\.md$/,'')}/`}>記事を読む ↗</a></article>)}</div></section>
<section class="contact-band"><div><span class="eyebrow">Contact / Start a conversation</span><h2>まずは、課題の整理から。</h2></div><a class="button" href="/contact/">お問い合わせフォームへ ↗</a></section>
</BaseLayout>