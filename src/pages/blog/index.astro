---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="ブログ | SI研究所" description="Web制作やシステム開発に関する情報をお届けします。">
<section class="page-heading"><span class="eyebrow">Journal & Insights</span><h1>ブログ</h1><p>Web、システム、業務改善についてのヒントをお届けします。</p></section>
<section class="section"><div class="blog-list">{posts.map((post) => <article class="blog-card"><div class="blog-meta"><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('ja-JP')}</time><span>{post.data.category}</span></div><h2><a href={`/blog/${post.id.replace(/\.md$/, '')}/`}>{post.data.title}</a></h2><p>{post.data.description}</p><a class="text-link" href={`/blog/${post.id.replace(/\.md$/, '')}/`}>記事を読む ↗</a></article>)}</div></section>
</BaseLayout>