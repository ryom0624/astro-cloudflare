---
import '../styles/global.css';
const { title = 'SI研究所 | Web・システム開発', description = 'Web制作、システム開発、SI導入支援でビジネスの次の一歩を支えます。' } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
<meta name="theme-color" content="#f5f3ee" />
<title>{title}</title>
<link rel="preconnect" href="https://images.unsplash.com" />
</head>
<body>
<header class="site-header">
<a class="brand" href="/"><span class="brand-mark">SI</span><span>SI研究所<small>SMART IDEAS, REAL IMPACT.</small></span></a>
<nav aria-label="メインナビゲーション">
<a class:active={path === '/'} href="/">トップ</a>
<a class:active={path === '/services/'} href="/services/">事業内容</a>
<a class:active={path === '/company/'} href="/company/">会社情報</a>
<a class:active={path.startsWith('/blog')} href="/blog/">ブログ</a>
<a class="nav-contact" href="mailto:info@example.com">お問い合わせ ↗</a>
</nav>
</header>
<main><slot /></main>
<footer class="site-footer">
<a class="brand" href="/"><span class="brand-mark">SI</span><span>SI研究所<small>SMART IDEAS, REAL IMPACT.</small></span></a>
<p>技術とアイデアで、ビジネスを前へ。</p>
<div class="footer-bottom"><span>© {new Date().getFullYear()} SI研究所</span><a href="/company/">会社情報</a><a href="/blog/">ブログ</a></div>
</footer>
</body>
</html>